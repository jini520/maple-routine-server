# 실제 값은 이 파일이 아니라 서버의 ~/.config/maple-routine-server/.env 에 둔다.
# 이 파일은 **어떤 이름이 필요한지**만 말한다. 값은 비워 둔다.

# 도커 네트워크 안에서 컨테이너 이름으로 붙는다. IP 를 안 쓴다.
DATABASE_URL=postgres://maple_routine:비밀번호@postgres:5432/maple_routine

# FCM 서비스 계정 키의 **경로**. 파일 자체는 저장소 밖에 둔다.
FCM_KEY=/run/secrets/fcm-key.json

# 듣는 포트. Oracle nginx 가 여기로 넘긴다.
PORT=4000
