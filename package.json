{
  "name": "maple-routine-server",
  "version": "0.2.0",
  "private": true,
  "description": "메이플 루틴 서버. NestJS MVC. 옛 서버는 legacy/ 에 있다",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,mjs,ts}\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "notice": "node dist/cli/notice.js",
    "migrate": "node dist/cli/migrate.js"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/../jest.setup.ts"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.2.0",
    "domhandler": "^6.0.1",
    "drizzle-orm": "^0.45.4",
    "firebase-admin": "^14.5.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
