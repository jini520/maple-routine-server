# 실제 값은 이 파일이 아니라 서버의 ~/.config/maple-routine-server/.env 에 둔다.
# 이 파일은 어떤 이름이 필요한지만 말한다. 값은 비워 둔다. src/config/env.schema.ts 가 같은 목록을 검사한다.

DATABASE_URL=postgres://maple_routine:비밀번호@db:5432/maple_routine
PORT=4000
# 넥슨에 등록한 redirect_uri 와 안드로이드 App Link 의 호스트.
PUBLIC_BASE_URL=https://mapleroutine.store
LOG_LEVEL=info

# FCM 서비스 계정 키의 경로. 파일 자체는 저장소 밖에 둔다.
FCM_KEY=/run/secrets/fcm-key.json

# 넥슨 Open API 키. 공지 폴링과 결산 감시가 쓴다. 서비스 단계 키여야 한다.
NEXON_KEY=
POLL_INTERVAL_MS=60000
SETTLEMENT_OCID=

# 넥슨 Open ID. 플랫폼마다 자격 쌍이 따로다.
NEXON_IOS_CLIENT_ID=
NEXON_IOS_CLIENT_SECRET=
NEXON_ANDROID_CLIENT_ID=
NEXON_ANDROID_CLIENT_SECRET=
# 로그인 때 청하는 scope. 쉼표로 잇는다. 프렌즈 6경로의 데이터 항목 Key 이고, 애플리케이션 상세의 활용 데이터 항목과 같아야 한다.
NEXON_OPENID_SCOPES=maplestory.characterlist,maplestory.starforce,maplestory.potential,maplestory.cube,maplestory.soulpotential,maplestory.scheduler

# 저장한 넥슨 토큰을 봉하는 열쇠. hex 64글자. 봉인 블롭 첫 바이트가 버전이고, 키를 바꿀 때 _V2 를 더한다.
TOKEN_ENC_KEY_V1=

# 프렌즈 조회 상한. 시작값이고 회차 로그를 보고 고친다.
FRIENDS_MAX_RUNS=40
FRIENDS_FANOUT=4
FRIENDS_RUN_DEADLINE_MS=120000
FRIENDS_RUN_BYTES=16777216
FRIENDS_NEXON_RPS=400
