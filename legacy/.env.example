# 실제 값은 이 파일이 아니라 서버의 ~/.config/maple-routine-server/.env 에 둔다.
# 이 파일은 **어떤 이름이 필요한지**만 말한다. 값은 비워 둔다.

# 도커 네트워크 안에서 컨테이너 이름으로 붙는다. IP 를 안 쓴다.
DATABASE_URL=postgres://maple_routine:비밀번호@postgres:5432/maple_routine

# FCM 서비스 계정 키의 **경로**. 파일 자체는 저장소 밖에 둔다.
FCM_KEY=/run/secrets/fcm-key.json

# 듣는 포트. Oracle nginx 가 여기로 넘긴다.
PORT=4000
PORT=4000

# 넥슨 Open API 키. **서비스 단계 키여야 한다.**
# 없으면 넥슨 공지를 안 받고 조회 API 만 연다. 개발 단계 키(초당 5건)를 꽂으면 씨 뿌리는
# 회차에서 429 가 나 그 분류가 통째로 밀린다.
NEXON_KEY=

# 폴링 간격(ms). 기본 60000.
# 넥슨 상세는 목록에 지금 떠 있는 것만 답해서, 목록에서 빠지면 그 글은 영영 못 받는다.
# 썬데이 메이플은 일요일 하루짜리다. 늘리기 전에 그것을 먼저 생각할 것.
POLL_INTERVAL_MS=60000

# 넥슨 Open ID 로그인(앱 ADR-296).
#
# **자격이 플랫폼마다 갈린다.** 넥슨 애플리케이션을 iOS 와 Android 로 따로 등록하게 돼 있고
# 각각 자기 client_id 와 secret 을 갖는다(2026-09-26 등록 화면 확인). 한 쌍만 채우면 그
# 플랫폼만 로그인이 되고, 다른 쪽은 시작 요청에서 멈춘다.
#
# 교환에 secret 이 필수라 앱에 둘 수 없고, 그래서 토큰을 이 서버가 든다.
NEXON_IOS_CLIENT_ID=
NEXON_IOS_CLIENT_SECRET=
NEXON_ANDROID_CLIENT_ID=
NEXON_ANDROID_CLIENT_SECRET=

# 저장한 넥슨 토큰을 감싸는 열쇠. **hex 64글자(32바이트)** 여야 한다.
# `openssl rand -hex 32` 로 만든다. 이 값을 잃으면 저장된 토큰을 못 풀고 전원 재로그인이다.
# DB 안에 두지 말 것 - 감싸는 의미가 없어진다.
TOKEN_ENC_KEY=

# 요청 로그 수준. 비우면 info 라 요청마다 한 줄이 찍힌다. 시끄러우면 warn 이나 silent.
LOG_LEVEL=

# 결산 판정에 쓰는 캐릭터의 ocid. 지금은 `낟낟` 이다.
# 없으면 결산 확인을 안 돌고 `GET /v1/settlement` 이 늘 `settling: false` 다.
# 그 캐릭터가 월드를 옮기면 ocid 가 바뀌어 `OPENAPI00003` 이 나고 판정이 모름으로 떨어진다.
SETTLEMENT_OCID=
